{
  "manifest_version": 3,
  "name": "YT Summarizer",
  "version": "1.0",
  "description": "Summarize YouTube videos via your local summarizer server",
  "permissions": ["activeTab", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:7823/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Summarizer"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
